# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

PORT=5000

# Local:  postgresql://postgres:password@localhost:5432/mcdm
# Render: copy the Internal Database URL from the dashboard
DATABASE_URL=postgresql://user:password@host:5432/database

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_CODE=

# Comma-separated list of origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:3000
